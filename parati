```html
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Para ti ❤️</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Georgia, serif;
            background: radial-gradient(circle at center, #24113d, #0b0715 70%);
            color: white;
            overflow-x: hidden;
        }

        /* Estrellas */
        .stars {
            position: fixed;
            inset: 0;
            pointer-events: none;
        }

        .star {
            position: absolute;
            width: 3px;
            height: 3px;
            background: white;
            border-radius: 50%;
            opacity: 0.8;
            animation: twinkle 2s infinite alternate;
        }

        @keyframes twinkle {
            from {
                opacity: 0.2;
            }
            to {
                opacity: 1;
            }
        }

        .container {
            width: 90%;
            max-width: 650px;
            text-align: center;
            padding: 35px 25px;
            position: relative;
            z-index: 2;
        }

        .heart {
            font-size: 70px;
            animation: heartbeat 1.5s infinite;
            margin-bottom: 20px;
        }

        @keyframes heartbeat {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.15);
            }
        }

        h1 {
            font-size: 32px;
            margin-bottom: 15px;
        }

        .subtitle {
            color: #d9c9e8;
            margin-bottom: 30px;
            font-size: 17px;
        }

        button {
            border: none;
            padding: 15px 28px;
            border-radius: 30px;
            background: #ff4f91;
            color: white;
            font-size: 17px;
            cursor: pointer;
            box-shadow: 0 0 20px rgba(255, 79, 145, 0.5);
            transition: 0.3s;
        }

        button:hover {
            transform: scale(1.06);
            box-shadow: 0 0 30px rgba(255, 79, 145, 0.8);
        }

        .message {
            display: none;
            margin-top: 30px;
            text-align: left;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 20px;
            padding: 28px;
            backdrop-filter: blur(10px);
            box-shadow: 0 0 30px rgba(0,0,0,0.3);
            animation: appear 1.5s ease;
        }

        @keyframes appear {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .message p {
            margin-bottom: 20px;
            line-height: 1.8;
            font-size: 17px;
        }

        .final {
            text-align: center;
            font-size: 20px !important;
            color: #ffb6d3;
            margin-top: 25px;
        }

        .signature {
            text-align: right;
            margin-top: 25px;
            color: #d9c9e8;
            font-style: italic;
        }

        .hidden {
            display: none;
        }

        @media (max-width: 600px) {

            h1 {
                font-size: 27px;
            }

            .heart {
                font-size: 60px;
            }

            .message {
                padding: 22px;
            }

            .message p {
                font-size: 16px;
            }
        }
    </style>
</head>

<body>

    <div class="stars"></div>

    <div class="container">

        <div class="heart">❤️</div>

        <h1>Para alguien especial 🌹</h1>

        <p class="subtitle">
            Tengo algo que quiero decirte...
        </p>

        <button onclick="mostrarMensaje()">
            Tengo algo que decirte 💌
        </button>

        <div class="message" id="mensaje">

            <p>
                Incluso si no tuviera ojos para verte 👀,
                sé que eres hermosa 🌹✨
            </p>

            <p>
                Incluso si no tuviera oídos para escucharte 👂,
                sé que tu voz es dulce 🎶💗
            </p>

            <p>
                Incluso si no tuviera nariz para olerte 👃,
                sé que tu fragancia es encantadora 🌸🫧
            </p>

            <p>
                Y aunque no tuviera manos para tocarte 🖐️,
                sé que tu piel es cálida 🤍🫂
            </p>

            <p class="final">
                Porque hay cosas que no necesitan ser vistas,
                escuchadas, olidas o tocadas para saber que son especiales… ❤️✨
            </p>

            <p class="final">
                Y tú eres una de ellas. 🌹💞
            </p>

            <p class="signature">
                — Para ti, con cariño ❤️
            </p>

        </div>

    </div>

    <script>

        // Crear estrellas
        const stars = document.querySelector(".stars");

        for (let i = 0; i < 100; i++) {

            const star = document.createElement("div");

            star.classList.add("star");

            star.style.left = Math.random() * 100 + "%";
            star.style.top = Math.random() * 100 + "%";

            star.style.animationDelay =
                Math.random() * 2 + "s";

            stars.appendChild(star);
        }

        // Mostrar mensaje
        function mostrarMensaje() {

            const mensaje = document.getElementById("mensaje");
            const boton = document.querySelector("button");
            const subtitulo = document.querySelector(".subtitle");

            mensaje.style.display = "block";

            boton.style.display = "none";

            subtitulo.textContent =
                "Espero que te guste... ❤️";

            mensaje.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
        }

    </script>

</body>
</html>
```
